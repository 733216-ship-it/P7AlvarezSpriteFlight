<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Label text="Score: 0" name="ScoreLabel" style="top: 20px; align-self: center; font-size: 30px; color: rgb(224, 255, 255); -unity-font-style: normal; border-top-width: 2px; border-left-color: rgb(224, 255, 255); border-right-color: rgb(224, 255, 255); border-top-color: rgb(224, 255, 255); border-bottom-color: rgb(224, 255, 255); border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px; width: 158px; height: 47px; background-size: 100% 100%;"/>
    <ui:Button text="Restart" name="RestartButton" style="align-self: center; top: 50%; font-size: 22px; color: rgb(255, 255, 255); -unity-font-style: bold; background-color: rgb(226, 0, 0); height: 51px; border-left-width: 3px; border-top-color: rgb(255, 255, 255); border-left-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-width: 3px; border-right-width: 3px; border-bottom-width: 3px; border-top-left-radius: 25px; border-top-right-radius: 25px; border-bottom-right-radius: 25px; border-bottom-left-radius: 25px;"/>
</ui:UXML>
